# =============================================================================
# Envpilot — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
#
# This file lives at the monorepo root. The web app (apps/web) reads it via
# a symlink: apps/web/.env.local → ../../.env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Convex
# -----------------------------------------------------------------------------
# Created automatically by `npx convex dev` on first run
CONVEX_DEPLOYMENT=dev:your-project-name
CONVEX_URL=https://your-project-name.convex.cloud
CONVEX_SITE_URL=https://your-project-name.convex.site
NEXT_PUBLIC_CONVEX_URL=https://your-project-name.convex.cloud

# -----------------------------------------------------------------------------
# WorkOS (Authentication)
# -----------------------------------------------------------------------------
# Get these from https://dashboard.workos.com
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_...
WORKOS_COOKIE_PASSWORD=a-random-string-at-least-32-characters-long
WORKOS_REDIRECT_URI=http://localhost:3000/callback

# --- Convex ↔ WorkOS JWT binding (DORMANT — see docs/CONVEX_AUTH_MIGRATION.md) --
# These bind Convex functions to server-verified WorkOS identity so functions
# stop trusting client-supplied userId args. They are INERT until (a) a WorkOS
# JWT template exists and (b) callers attach tokens. They belong in the CONVEX
# DEPLOYMENT's env (Convex functions read their own env), NOT in .env.local:
#   npx convex env set WORKOS_JWT_ISSUER          https://api.workos.com/user_management/<WORKOS_CLIENT_ID>
#   npx convex env set WORKOS_CONVEX_APPLICATION_ID <aud from the JWT template>
# WORKOS_JWT_ISSUER: the JWT `iss` (issuer/JWKS) URL Convex trusts.
# WORKOS_JWT_ISSUER=https://api.workos.com/user_management/client_...
# WORKOS_CONVEX_APPLICATION_ID: the JWT `aud` (audience) Convex requires; must
# match the audience configured in the WorkOS JWT template (often the client id).
# WORKOS_CONVEX_APPLICATION_ID=client_...

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Admin Dashboard (Vite)
# -----------------------------------------------------------------------------
# Same Convex URL, prefixed with VITE_ for Vite apps
VITE_CONVEX_URL=https://your-project-name.convex.cloud
# Set admin secret in Convex env vars:
#   npx convex env set ADMIN_SECRET your-strong-random-secret

# -----------------------------------------------------------------------------
# Tier Limits
# -----------------------------------------------------------------------------
# Tier enforcement is now managed via the Admin Dashboard toggle (stored in DB).
# The ENFORCE_TIER_LIMITS env var is used as a FALLBACK if no DB setting exists:
#   npx convex env set ENFORCE_TIER_LIMITS false   (pre-alpha: no limits)
#   npx convex env set ENFORCE_TIER_LIMITS true    (production: enforce limits)
# Once you toggle it from the admin panel, the DB setting takes precedence.

# -----------------------------------------------------------------------------
# Polar.sh (Billing) — optional, disabled by default
# -----------------------------------------------------------------------------
# Set NEXT_PUBLIC_PAYMENTS_ENABLED=true to enable billing features
# NEXT_PUBLIC_PAYMENTS_ENABLED=true
# POLAR_ACCESS_TOKEN=polar_oat_...
# POLAR_WEBHOOK_SECRET=polar_whs_...
# POLAR_SERVER=sandbox

# -----------------------------------------------------------------------------
# Resend (Email) — optional
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_...
# FROM_EMAIL=Envpilot <noreply@yourdomain.com>

# -----------------------------------------------------------------------------
# Sentry (Error Tracking) — optional
# -----------------------------------------------------------------------------
# Get your DSN from https://sentry.io/settings/projects/envpilot/keys/
# Dashboard: https://syntax-lab-technology.sentry.io/issues/
SENTRY_DSN=https://24f72269c7fbd01271c7df8c6bd50744@o4509762173009920.ingest.de.sentry.io/4511055962505296
NEXT_PUBLIC_SENTRY_DSN=https://24f72269c7fbd01271c7df8c6bd50744@o4509762173009920.ingest.de.sentry.io/4511055962505296
# SENTRY_AUTH_TOKEN=sntrys_...  # Get from https://sentry.io/settings/auth-tokens/
SENTRY_ORG=syntax-lab-technology
SENTRY_PROJECT=envpilot
# For CLI/Extension production builds (build-time DSN injection):
# SENTRY_CLI_DSN=https://24f72269c7fbd01271c7df8c6bd50744@o4509762173009920.ingest.de.sentry.io/4511055962505296
# SENTRY_EXTENSION_DSN=https://24f72269c7fbd01271c7df8c6bd50744@o4509762173009920.ingest.de.sentry.io/4511055962505296

# -----------------------------------------------------------------------------
# Umami Analytics — optional
# -----------------------------------------------------------------------------
# Website tracking (client-side)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=60587dad-c4a2-4de4-9e6f-9297c7e7d9e5
# Admin traffic dashboard (set in Convex env vars):
#   npx convex env set UMAMI_API_KEY your-umami-cloud-api-key
#   npx convex env set UMAMI_WEBSITE_ID 60587dad-c4a2-4de4-9e6f-9297c7e7d9e5
#   npx convex env set UMAMI_SHARE_URL https://cloud.umami.is/analytics/us/share/d2jLAHqW0Rx2BvJh
