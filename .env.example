# =============================================================================
# Envpilot — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
#
# This file lives at the monorepo root. The web app (apps/web) reads it via
# a symlink: apps/web/.env.local → ../../.env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Convex
# -----------------------------------------------------------------------------
# Created automatically by `npx convex dev` on first run
CONVEX_DEPLOYMENT=dev:your-project-name
CONVEX_URL=https://your-project-name.convex.cloud
CONVEX_SITE_URL=https://your-project-name.convex.site
NEXT_PUBLIC_CONVEX_URL=https://your-project-name.convex.cloud

# -----------------------------------------------------------------------------
# WorkOS (Authentication)
# -----------------------------------------------------------------------------
# Get these from https://dashboard.workos.com
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_...
WORKOS_COOKIE_PASSWORD=a-random-string-at-least-32-characters-long
WORKOS_REDIRECT_URI=http://localhost:3000/callback

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Stripe (Billing) — optional, disabled by default
# -----------------------------------------------------------------------------
# Set NEXT_PUBLIC_PAYMENTS_ENABLED=true to enable billing features
# NEXT_PUBLIC_PAYMENTS_ENABLED=true
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...

# -----------------------------------------------------------------------------
# Resend (Email) — optional
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_...
# FROM_EMAIL=Envpilot <noreply@yourdomain.com>
