version: 2.1

# ═══════════════════════════════════════════════════════════════════════
# PIPELINE v2 — SETUP PHASE (dynamic config)
#
# This tiny config runs first on every push (~15s, `small` class). It
# detects WHICH surfaces changed, merges in any manual force parameters,
# and continues into .circleci/continue.yml with one boolean per surface.
# Jobs for unchanged surfaces are never created — no more 22s ghost jobs.
#
# Surfaces: convex, web, blog, docs, admin, cli, extension, action.
# ADDING A SURFACE (e.g. the planned Android app):
#   1. add a `force-<name>` parameter below AND in continue.yml
#   2. add a path rule in the detect script below
#   3. add build/deploy jobs + a workflow gate in continue.yml
#
# MANUAL CONTROL — trigger from the CircleCI UI ("Trigger Pipeline" on
# the project, pick branch, add parameters) or the API:
#   curl -X POST https://circleci.com/api/v2/project/<slug>/pipeline \
#     -H "Circle-Token: $TOKEN" -H "Content-Type: application/json" \
#     -d '{"branch":"main","parameters":{"force-cli":true}}'
#   force-<surface>: true  → run that surface's jobs even if unchanged
#   run-everything: true   → run all surfaces
# Deploys still ONLY happen on main — forcing on a branch runs builds only.
# ═══════════════════════════════════════════════════════════════════════

setup: true

orbs:
  continuation: circleci/continuation@1.1.0

parameters:
  run-everything:
    type: boolean
    default: false
  force-convex:
    type: boolean
    default: false
  force-web:
    type: boolean
    default: false
  force-blog:
    type: boolean
    default: false
  force-docs:
    type: boolean
    default: false
  force-admin:
    type: boolean
    default: false
  force-cli:
    type: boolean
    default: false
  force-extension:
    type: boolean
    default: false
  force-action:
    type: boolean
    default: false

jobs:
  detect:
    docker:
      - image: cimg/base:current
    resource_class: small
    steps:
      - checkout
      - run:
          name: Detect changed surfaces
          command: |
            set -euo pipefail

            # ── What are we diffing against? ─────────────────────────
            # main: the merge itself (squash merges → first-parent diff
            # covers the whole PR). branches: everything vs the fork
            # point with main, so re-pushes keep the same surface set.
            if [ "$CIRCLE_BRANCH" = "main" ]; then
              RANGE="HEAD^..HEAD"
              IS_MAIN=true
            else
              git fetch origin main --quiet
              BASE=$(git merge-base origin/main HEAD)
              RANGE="$BASE..HEAD"
              IS_MAIN=false
            fi
            CHANGED=$(git diff --name-only "$RANGE")
            printf 'Changed files vs %s:\n%s\n\n' "$RANGE" "$CHANGED"

            hit() { echo "$CHANGED" | grep -qE "$1" && echo true || echo false; }

            CONVEX=$(hit '^convex/')
            WEB=$(hit '^apps/web/')
            BLOG=$(hit '^apps/blog/')
            DOCS=$(hit '^apps/docs/')
            ADMIN=$(hit '^apps/admin/')
            CLI=$(hit '^apps/cli/')
            EXTENSION=$(hit '^apps/vscode-extension/')
            ACTION=$(hit '^packages/github-action/')

            # packages/ui feeds the three Next sites + web.
            if [ "$(hit '^packages/ui/')" = "true" ]; then
              WEB=true; BLOG=true; DOCS=true
            fi

            # Root manifests / shared configs / this pipeline → everything.
            if [ "$(hit '^(package\.json|bun\.lock|turbo\.json|\.circleci/|packages/(tsconfig|eslint-config|prettier-config)/)')" = "true" ]; then
              CONVEX=true; WEB=true; BLOG=true; DOCS=true; ADMIN=true
              CLI=true; EXTENSION=true; ACTION=true
            fi

            # Manual overrides.
            if [ "<< pipeline.parameters.run-everything >>" = "true" ]; then
              CONVEX=true; WEB=true; BLOG=true; DOCS=true; ADMIN=true
              CLI=true; EXTENSION=true; ACTION=true
            fi
            if [ "<< pipeline.parameters.force-convex >>" = "true" ]; then CONVEX=true; fi
            if [ "<< pipeline.parameters.force-web >>" = "true" ]; then WEB=true; fi
            if [ "<< pipeline.parameters.force-blog >>" = "true" ]; then BLOG=true; fi
            if [ "<< pipeline.parameters.force-docs >>" = "true" ]; then DOCS=true; fi
            if [ "<< pipeline.parameters.force-admin >>" = "true" ]; then ADMIN=true; fi
            if [ "<< pipeline.parameters.force-cli >>" = "true" ]; then CLI=true; fi
            if [ "<< pipeline.parameters.force-extension >>" = "true" ]; then EXTENSION=true; fi
            if [ "<< pipeline.parameters.force-action >>" = "true" ]; then ACTION=true; fi

            # ── Generate the continuation config ─────────────────────
            # Job definitions come verbatim from .circleci/jobs.yml; the
            # workflow below contains ONLY the jobs that matter, with
            # `requires` chains computed so any failure blocks everything
            # downstream (quality gates all; convex before clients).
            cp .circleci/jobs.yml /tmp/continue.yml
            {
              echo ""
              echo "workflows:"
              echo "  pipeline:"
              echo "    jobs:"
              echo "      - quality"

              if [ "$WEB" = "true" ]; then echo "      - build-web:       { requires: [quality] }"; fi
              if [ "$BLOG" = "true" ]; then echo "      - build-blog:      { requires: [quality] }"; fi
              if [ "$DOCS" = "true" ]; then echo "      - build-docs:      { requires: [quality] }"; fi
              if [ "$ADMIN" = "true" ]; then echo "      - build-admin:     { requires: [quality] }"; fi
              if [ "$CLI" = "true" ]; then echo "      - build-cli:       { requires: [quality] }"; fi
              if [ "$EXTENSION" = "true" ]; then echo "      - build-extension: { requires: [quality] }"; fi
              if [ "$ACTION" = "true" ]; then echo "      - build-action:    { requires: [quality] }"; fi

              if [ "$IS_MAIN" = "true" ]; then
                # Backend first: clients require deploy-convex when it exists.
                AFTER_CONVEX=""
                if [ "$CONVEX" = "true" ]; then
                  echo "      - deploy-convex:   { requires: [quality] }"
                  AFTER_CONVEX=", deploy-convex"
                fi
                RELEASE_REQS=""
                if [ "$CONVEX" = "true" ]; then RELEASE_REQS="deploy-convex"; fi
                if [ "$CLI" = "true" ]; then
                  echo "      - publish-cli:     { requires: [build-cli${AFTER_CONVEX}] }"
                  echo "      - deploy-homebrew: { requires: [publish-cli] }"
                  RELEASE_REQS="${RELEASE_REQS:+$RELEASE_REQS, }publish-cli"
                fi
                if [ "$EXTENSION" = "true" ]; then
                  echo "      - publish-extension: { requires: [build-extension${AFTER_CONVEX}] }"
                  RELEASE_REQS="${RELEASE_REQS:+$RELEASE_REQS, }publish-extension"
                fi
                if [ "$ACTION" = "true" ]; then
                  echo "      - publish-action:  { requires: [build-action${AFTER_CONVEX}] }"
                  RELEASE_REQS="${RELEASE_REQS:+$RELEASE_REQS, }publish-action"
                fi
                if [ "$WEB" = "true" ]; then
                  echo "      - deploy-web:      { requires: [build-web${AFTER_CONVEX}] }"
                  RELEASE_REQS="${RELEASE_REQS:+$RELEASE_REQS, }deploy-web"
                fi
                if [ "$BLOG" = "true" ]; then
                  echo "      - deploy-blog:     { requires: [build-blog] }"
                  RELEASE_REQS="${RELEASE_REQS:+$RELEASE_REQS, }deploy-blog"
                fi
                if [ "$DOCS" = "true" ]; then
                  echo "      - deploy-docs:     { requires: [build-docs] }"
                  RELEASE_REQS="${RELEASE_REQS:+$RELEASE_REQS, }deploy-docs"
                fi
                if [ "$ADMIN" = "true" ]; then
                  echo "      - deploy-admin:    { requires: [build-admin] }"
                  RELEASE_REQS="${RELEASE_REQS:+$RELEASE_REQS, }deploy-admin"
                fi
                if [ -n "$RELEASE_REQS" ]; then
                  echo "      - release:         { requires: [$RELEASE_REQS] }"
                fi
              fi
            } >> /tmp/continue.yml
            echo "── Generated continuation ──"
            tail -40 /tmp/continue.yml
      - continuation/continue:
          configuration_path: /tmp/continue.yml

workflows:
  setup:
    jobs:
      - detect
