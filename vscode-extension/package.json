{
  "name": "env-connect",
  "displayName": "ENV Connect",
  "description": "Securely sync environment variables from ENV Connect to your local projects",
  "version": "0.1.0",
  "publisher": "env-connect",
  "repository": {
    "type": "git",
    "url": "https://github.com/env-connect/env-connect"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "environment",
    "variables",
    "env",
    "secrets",
    "dotenv",
    "configuration"
  ],
  "activationEvents": [
    "workspaceContains:.env*",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "envConnect.signIn",
        "title": "Sign In",
        "category": "ENV Connect"
      },
      {
        "command": "envConnect.signOut",
        "title": "Sign Out",
        "category": "ENV Connect"
      },
      {
        "command": "envConnect.linkProject",
        "title": "Link Project",
        "category": "ENV Connect"
      },
      {
        "command": "envConnect.unlinkProject",
        "title": "Unlink Project",
        "category": "ENV Connect"
      },
      {
        "command": "envConnect.pullVariables",
        "title": "Pull Variables",
        "category": "ENV Connect"
      },
      {
        "command": "envConnect.refresh",
        "title": "Refresh",
        "category": "ENV Connect"
      },
      {
        "command": "envConnect.openDashboard",
        "title": "Open Dashboard",
        "category": "ENV Connect"
      },
      {
        "command": "envConnect.showStatus",
        "title": "Show Status",
        "category": "ENV Connect"
      },
      {
        "command": "envConnect.addDirectory",
        "title": "Add Directory",
        "category": "ENV Connect",
        "icon": "$(add)"
      },
      {
        "command": "envConnect.removeDirectory",
        "title": "Remove Directory",
        "category": "ENV Connect",
        "icon": "$(trash)"
      },
      {
        "command": "envConnect.selectEnvironments",
        "title": "Select Environments",
        "category": "ENV Connect"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "env-connect",
          "title": "ENV Connect",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "env-connect": [
        {
          "id": "envConnect.projects",
          "name": "Projects"
        },
        {
          "id": "envConnect.variables",
          "name": "Variables"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "envConnect.refresh",
          "when": "view == envConnect.projects",
          "group": "navigation"
        },
        {
          "command": "envConnect.pullVariables",
          "when": "view == envConnect.variables",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "envConnect.linkProject",
          "when": "view == envConnect.projects && viewItem == project",
          "group": "inline"
        },
        {
          "command": "envConnect.unlinkProject",
          "when": "view == envConnect.projects && viewItem == linkedProject",
          "group": "inline"
        },
        {
          "command": "envConnect.addDirectory",
          "when": "view == envConnect.projects && viewItem == linkedProject",
          "group": "inline"
        },
        {
          "command": "envConnect.removeDirectory",
          "when": "view == envConnect.projects && viewItem == linkedDirectory",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "ENV Connect",
      "properties": {
        "envConnect.serverUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "The URL of the ENV Connect server"
        },
        "envConnect.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Automatically sync variables when workspace opens"
        },
        "envConnect.syncInterval": {
          "type": "number",
          "default": 300,
          "description": "Interval (in seconds) for checking permission changes",
          "minimum": 60,
          "maximum": 3600
        },
        "envConnect.targetFile": {
          "type": "string",
          "default": ".env.local",
          "description": "Default target file for synced variables"
        },
        "envConnect.environment": {
          "type": "string",
          "default": "development",
          "enum": [
            "development",
            "staging",
            "production"
          ],
          "description": "Default environment for synced variables"
        },
        "envConnect.preventCopyOnRevoke": {
          "type": "boolean",
          "default": true,
          "description": "Delete synced .env files when permissions are revoked"
        },
        "envConnect.defaultConflictResolution": {
          "type": "string",
          "default": "prompt",
          "enum": [
            "prompt",
            "overwrite",
            "backup",
            "merge",
            "skip"
          ],
          "enumDescriptions": [
            "Always ask what to do",
            "Replace existing file",
            "Create backup before replacing",
            "Merge with existing file",
            "Skip conflicting directories"
          ],
          "description": "Default action when existing .env files are found"
        },
        "envConnect.enableMultiDirectorySync": {
          "type": "boolean",
          "default": true,
          "description": "Allow linking multiple directories to the same project"
        },
        "envConnect.syncOnDirectoryOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically sync when opening a linked directory"
        },
        "envConnect.enableRealTimeSync": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time permission revocation detection (recommended)"
        },
        "envConnect.realTimeSyncInterval": {
          "type": "number",
          "default": 5,
          "description": "Interval (in seconds) for real-time permission check",
          "minimum": 2,
          "maximum": 30
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "esbuild": "^0.19.8",
    "eslint": "^8.54.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.3.2",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "uuid": "^9.0.1"
  }
}
