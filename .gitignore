# dependencies
node_modules/

# build outputs
dist/
.next/
# Scratch build dirs from NEXT_DIST_DIR, used to verify a build without
# clobbering a running dev server's .next
.next-*/
out/
build/

# turbo
.turbo/

# fallow
.fallow/

# testing
coverage/

# env files
.env*
!.env.example

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# VS Code extension artifacts
*.vsix

# CLI compiled binaries
binaries/

# vercel
.vercel

# lock files (only bun.lock is committed)
package-lock.json

# automaker
.automaker/
.env

# playwright artifacts
test-results/
playwright-report/
# saved e2e auth sessions (contain live session cookies)
apps/web/tests/e2e/.auth/
.claude/worktrees/
.frugal-fable/

# commandcode tool config
.commandcode/

# Local Convex backend state (convex dev --dev-deployment local)
.convex/
.env*.local

# Editor settings
.vscode/

.firecrawl/
claude_html/

# Sandbox build values for the CLI / extension. Never committed: it is the one
# file that decides which deployment a local build talks to.
apps/cli/scripts/sandbox.env
apps/vscode-extension/scripts/sandbox.env
