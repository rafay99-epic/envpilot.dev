name: Release VS Code Extension

on:
  push:
    branches:
      - main
    paths:
      - "apps/vscode-extension/**"
  workflow_dispatch:
    inputs:
      dry_run:
        description: "Dry run (skip publishing)"
        type: boolean
        default: false

permissions:
  contents: write

concurrency:
  group: release-extension
  cancel-in-progress: false

jobs:
  # ──────────────────────────────────────────────────────────
  # 1. Detect whether a new version needs to be published
  # ──────────────────────────────────────────────────────────
  detect:
    name: Detect version change
    runs-on: ubuntu-latest
    outputs:
      should_publish: ${{ steps.compare.outputs.should_publish }}
      local_version: ${{ steps.compare.outputs.local_version }}
      ovsx_version: ${{ steps.compare.outputs.ovsx_version }}
      marketplace_version: ${{ steps.compare.outputs.marketplace_version }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Compare local vs published versions
        id: compare
        run: |
          LOCAL_VERSION=$(jq -r '.version' apps/vscode-extension/package.json)
          echo "local_version=${LOCAL_VERSION}" >> "$GITHUB_OUTPUT"

          # Check Open VSX Registry
          OVSX_VERSION=$(curl -sf "https://open-vsx.org/api/envpilot/envpilot" | jq -r '.version // empty' 2>/dev/null || echo "")
          echo "ovsx_version=${OVSX_VERSION:-unpublished}" >> "$GITHUB_OUTPUT"

          # Check VS Code Marketplace
          MARKETPLACE_VERSION=$(npx @vscode/vsce show envpilot.envpilot --json 2>/dev/null | jq -r '.versions[0].version // empty' 2>/dev/null || echo "")
          echo "marketplace_version=${MARKETPLACE_VERSION:-unpublished}" >> "$GITHUB_OUTPUT"

          # Publish if version differs from either registry
          NEEDS_OVSX="false"
          NEEDS_MARKETPLACE="false"

          if [ "$LOCAL_VERSION" != "$OVSX_VERSION" ]; then
            NEEDS_OVSX="true"
            echo "Open VSX needs update: ${OVSX_VERSION:-unpublished} -> ${LOCAL_VERSION}"
          fi

          if [ "$LOCAL_VERSION" != "$MARKETPLACE_VERSION" ]; then
            NEEDS_MARKETPLACE="true"
            echo "VS Code Marketplace needs update: ${MARKETPLACE_VERSION:-unpublished} -> ${LOCAL_VERSION}"
          fi

          if [ "$NEEDS_OVSX" == "true" ] || [ "$NEEDS_MARKETPLACE" == "true" ]; then
            echo "should_publish=true" >> "$GITHUB_OUTPUT"
            echo "New version detected: v${LOCAL_VERSION}"
          else
            echo "should_publish=false" >> "$GITHUB_OUTPUT"
            echo "Version ${LOCAL_VERSION} is already published everywhere — skipping."
          fi

  # ──────────────────────────────────────────────────────────
  # 2. CI gate — lint, typecheck, and build must pass
  # ──────────────────────────────────────────────────────────
  ci:
    name: CI checks
    runs-on: ubuntu-latest
    needs: detect
    if: needs.detect.outputs.should_publish == 'true'
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Bun
        uses: oven-sh/setup-bun@v2

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Cache dependencies
        uses: actions/cache@v4
        with:
          path: ~/.bun/install/cache
          key: bun-${{ runner.os }}-${{ hashFiles('bun.lock') }}
          restore-keys: bun-${{ runner.os }}-

      - name: Install dependencies
        run: bun install --frozen-lockfile

      - name: Lint
        run: bunx turbo lint --filter=envpilot

      - name: Typecheck
        run: bunx turbo typecheck --filter=envpilot

      - name: Build
        run: bunx turbo build --filter=envpilot --force
        env:
          ENVPILOT_SERVER_URL: https://www.envpilot.dev

  # ──────────────────────────────────────────────────────────
  # 3. Build VSIX and publish to all registries
  # ──────────────────────────────────────────────────────────
  publish:
    name: Publish extension
    runs-on: ubuntu-latest
    needs: [detect, ci]
    if: needs.detect.outputs.should_publish == 'true'
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Bun
        uses: oven-sh/setup-bun@v2

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Cache dependencies
        uses: actions/cache@v4
        with:
          path: ~/.bun/install/cache
          key: bun-${{ runner.os }}-${{ hashFiles('bun.lock') }}
          restore-keys: bun-${{ runner.os }}-

      - name: Install dependencies
        run: bun install --frozen-lockfile

      - name: Build extension
        run: bunx turbo build --filter=envpilot --force
        env:
          ENVPILOT_SERVER_URL: https://www.envpilot.dev

      - name: Package VSIX
        id: vsix
        working-directory: apps/vscode-extension
        run: |
          npx @vscode/vsce package --no-dependencies
          VSIX_FILE=$(ls -1 *.vsix | head -1)
          echo "file=${VSIX_FILE}" >> "$GITHUB_OUTPUT"
          echo "path=apps/vscode-extension/${VSIX_FILE}" >> "$GITHUB_OUTPUT"
          echo "Packaged: ${VSIX_FILE}"

      - name: Upload VSIX artifact
        uses: actions/upload-artifact@v4
        with:
          name: envpilot-vsix-${{ needs.detect.outputs.local_version }}
          path: apps/vscode-extension/${{ steps.vsix.outputs.file }}
          retention-days: 30

      # ── VS Code Marketplace ──────────────────────────────
      # Publishing here also makes it available in Cursor,
      # which reads extensions from the VS Code Marketplace.
      - name: Publish to VS Code Marketplace
        if: ${{ !(github.event.inputs.dry_run == 'true') }}
        working-directory: apps/vscode-extension
        run: |
          echo "Publishing ${{ steps.vsix.outputs.file }} to VS Code Marketplace..."
          npx @vscode/vsce publish --no-dependencies --packagePath "${{ steps.vsix.outputs.file }}" -p "${{ secrets.VSCODE_MARKETPLACE_TOKEN }}"
          echo "Published to VS Code Marketplace (also available in Cursor)"

      # ── Open VSX Registry ────────────────────────────────
      # Covers VS Codium, Gitpod, Eclipse Theia, and other
      # editors that use the Open VSX ecosystem.
      - name: Publish to Open VSX Registry
        if: ${{ !(github.event.inputs.dry_run == 'true') }}
        working-directory: apps/vscode-extension
        run: |
          echo "Publishing ${{ steps.vsix.outputs.file }} to Open VSX..."
          npx ovsx publish "${{ steps.vsix.outputs.file }}" -p "${{ secrets.OPEN_VSX_TOKEN }}"
          echo "Published to Open VSX: https://open-vsx.org/extension/envpilot/envpilot"

      - name: Dry run summary
        if: ${{ github.event.inputs.dry_run == 'true' }}
        run: |
          echo "Dry run — would have published envpilot@${{ needs.detect.outputs.local_version }}"
          echo "  -> VS Code Marketplace (+ Cursor)"
          echo "  -> Open VSX Registry"
          echo "VSIX: ${{ steps.vsix.outputs.file }}"

  # ──────────────────────────────────────────────────────────
  # 4. Tag the commit and create a GitHub Release
  # ──────────────────────────────────────────────────────────
  release:
    name: Create GitHub Release
    runs-on: ubuntu-latest
    needs: [detect, publish]
    if: needs.detect.outputs.should_publish == 'true' && !(github.event.inputs.dry_run == 'true')
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Download VSIX artifact
        uses: actions/download-artifact@v4
        with:
          name: envpilot-vsix-${{ needs.detect.outputs.local_version }}

      - name: Create and push tag
        run: |
          TAG="extension-v${{ needs.detect.outputs.local_version }}"
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git tag -a "$TAG" -m "Release VS Code Extension v${{ needs.detect.outputs.local_version }}"
          git push origin "$TAG"

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: extension-v${{ needs.detect.outputs.local_version }}
          name: "Envpilot Extension v${{ needs.detect.outputs.local_version }}"
          body: |
            ## Envpilot VS Code Extension v${{ needs.detect.outputs.local_version }}

            ### Install

            **VS Code / Cursor:**
            ```
            ext install envpilot.envpilot
            ```
            or download from [VS Code Marketplace](https://marketplace.visualstudio.com/items?itemName=envpilot.envpilot)

            **Open VSX (VS Codium, Gitpod, Theia):**
            Install from [Open VSX Registry](https://open-vsx.org/extension/envpilot/envpilot)

            **Manual install:**
            Download the `.vsix` file below and run:
            ```bash
            code --install-extension envpilot-${{ needs.detect.outputs.local_version }}.vsix
            ```
          generate_release_notes: true
          files: "*.vsix"
