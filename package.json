{
  "name": "env-connect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:next dev:convex",
    "dev:next": "next dev",
    "dev:convex": "convex dev",
    "build": "next build",
    "build:all": "npm-run-all build cli:build extension:build",
    "start": "next start",
    "lint": "eslint",
    "lint:all": "npm-run-all lint cli:lint extension:lint",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "npm-run-all typecheck extension:typecheck",
    "format:check": "npx -y prettier@3.6.2 --check .",
    "react:doctor": "npx -y react-doctor@latest . --yes --offline --fail-on none --score",
    "cli:lint": "npm --prefix ./cli run lint",
    "cli:typecheck": "npm --prefix ./cli run typecheck",
    "cli:build": "npm --prefix ./cli run build",
    "cli:check": "npm-run-all cli:lint cli:build",
    "extension:lint": "npm --prefix ./vscode-extension run lint",
    "extension:typecheck": "npm --prefix ./vscode-extension run check-types",
    "extension:build": "npm --prefix ./vscode-extension run compile",
    "extension:check": "npm-run-all extension:typecheck extension:lint extension:build",
    "check:all": "npm-run-all format:check typecheck lint build cli:check extension:check react:doctor",
    "test:e2e": "playwright test",
    "convex:deploy": "convex deploy"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/three": "^0.183.0",
    "@workos-inc/authkit-nextjs": "^2.14.0",
    "@workos-inc/node": "^8.5.0",
    "convex": "^1.32.0",
    "date-fns": "^4.1.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.2",
    "stripe": "^20.3.1",
    "three": "^0.183.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
