{
  "name": "envpilot-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names web,convex --prefix-colors blue,green \"turbo dev --filter=@envpilot/web\" \"convex dev\"",
    "dev:web": "turbo dev --filter=@envpilot/web",
    "dev:convex": "convex dev",
    "dev:cli": "turbo dev --filter=@envpilot/cli",
    "dev:extension": "turbo dev --filter=envpilot",
    "build": "turbo build",
    "build:web": "turbo build --filter=@envpilot/web",
    "build:cli": "turbo build --filter=@envpilot/cli",
    "build:extension": "turbo build --filter=envpilot",
    "package:extension": "cd apps/vscode-extension && npx @vscode/vsce package --no-dependencies",
    "lint": "turbo lint",
    "lint:web": "turbo lint --filter=@envpilot/web",
    "lint:cli": "turbo lint --filter=@envpilot/cli",
    "lint:extension": "turbo lint --filter=envpilot",
    "typecheck": "turbo typecheck",
    "typecheck:web": "turbo typecheck --filter=@envpilot/web",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "test:e2e": "turbo test:e2e --filter=@envpilot/web",
    "test:cli": "turbo test --filter=@envpilot/cli",
    "test:extension": "turbo test --filter=envpilot",
    "check:all": "turbo lint typecheck build && prettier --check .",
    "convex:deploy": "convex deploy",
    "setup": "cp -n .env.example .env.local 2>/dev/null; ln -sf ../../.env.local apps/web/.env.local && echo 'Environment ready — edit .env.local with your values'",
    "generate:secret": "openssl rand -base64 32 | tr -d '\\n' && echo ''"
  },
  "devDependencies": {
    "@envpilot/prettier-config": "workspace:*",
    "concurrently": "^9.1.2",
    "convex": "^1.32.0",
    "prettier": "^3.6.2",
    "turbo": "^2"
  },
  "prettier": "@envpilot/prettier-config"
}
