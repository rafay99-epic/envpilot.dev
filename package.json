{
  "name": "env-connect",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.2.5",
  "workspaces": [
    "apps/*",
    "packages/*",
    "convex"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@env-connect/web --filter=@env-connect/backend",
    "dev:web": "turbo run dev --filter=@env-connect/web",
    "dev:convex": "turbo run dev --filter=@env-connect/backend",
    "dev:cli": "turbo run dev --filter=@env-connect/cli",
    "dev:extension": "turbo run watch --filter=./apps/vscode-extension",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@env-connect/web",
    "build:cli": "turbo run build --filter=@env-connect/cli",
    "build:extension": "turbo run build --filter=./apps/vscode-extension",
    "package:extension": "turbo run package --filter=./apps/vscode-extension",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=@env-connect/web",
    "format:check": "bunx prettier@3.6.2 --check .",
    "format:fix": "bunx prettier@3.6.2 --write ."
  },
  "dependencies": {
    "convex": "^1.32.0"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "prettier": "^3.6.2"
  }
}
