{
  "name": "env-connect",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.2.5",
  "workspaces": [
    "apps/*",
    "packages/*",
    "convex"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:all": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=@env-connect/web",
    "format:check": "bunx prettier@3.6.2 --check .",
    "format:fix": "bunx prettier@3.6.2 --write ."
  },
  "dependencies": {
    "convex": "^1.32.0"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "prettier": "^3.6.2"
  }
}
