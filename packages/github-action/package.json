{
  "name": "@envpilot/github-action",
  "version": "1.1.0",
  "description": "GitHub Action that pulls environment variables from Envpilot into a workflow job",
  "private": true,
  "license": "MIT",
  "author": "Envpilot <hello@envpilot.dev> (https://www.envpilot.dev)",
  "homepage": "https://www.envpilot.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafay99-epic/envpilot.dev"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
