{
  "name": "@envpilot/github-action",
  "version": "1.0.0",
  "description": "GitHub Action to securely pull Envpilot secrets into CI/CD pipelines",
  "type": "module",
  "main": "dist/main/index.js",
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^1.11.1"
  },
  "devDependencies": {
    "@envpilot/eslint-config": "workspace:*",
    "@envpilot/tsconfig": "workspace:*",
    "@types/node": "^22.10.10",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "github-action",
    "env",
    "environment",
    "variables",
    "secrets",
    "ci-cd",
    "envpilot"
  ],
  "author": "Envpilot <hello@envpilot.dev> (https://www.envpilot.dev)",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafay99-epic/envpilot.dev"
  },
  "homepage": "https://www.envpilot.dev",
  "bugs": {
    "url": "https://github.com/rafay99-epic/envpilot.dev/issues"
  }
}
