{
  "name": "@envpilot/github-action",
  "version": "1.0.0",
  "description": "GitHub Action to inject Envpilot environment variables into CI/CD workflows",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --minify",
    "dev": "esbuild src/main.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@actions/core": "^1.10.1"
  },
  "devDependencies": {
    "@envpilot/eslint-config": "workspace:*",
    "@envpilot/tsconfig": "workspace:*",
    "@types/node": "^22.10.10",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Envpilot <hello@envpilot.dev> (https://www.envpilot.dev)",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafay99-epic/envpilot.dev"
  },
  "homepage": "https://www.envpilot.dev",
  "bugs": {
    "url": "https://github.com/rafay99-epic/envpilot.dev/issues"
  }
}
