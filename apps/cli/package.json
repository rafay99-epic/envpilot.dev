{
  "name": "@envpilot/cli",
  "version": "1.23.0",
  "description": "Envpilot CLI — sync and manage environment variables from the terminal",
  "type": "module",
  "bin": {
    "envpilot": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@sentry/node": "^10.43.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "conf": "^13.0.1",
    "convex": "^1.32.0",
    "cross-spawn": "^7.0.6",
    "ink": "^5.2.1",
    "inquirer": "^12.3.2",
    "open": "^10.1.0",
    "ora": "^8.1.1",
    "proper-lockfile": "^4.1.2",
    "react": "^18.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@envpilot/eslint-config": "workspace:*",
    "@envpilot/secret-files": "workspace:*",
    "@envpilot/tsconfig": "workspace:*",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.10",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^18.3.12",
    "eslint": "^9",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "env",
    "environment",
    "variables",
    "cli",
    "dotenv",
    "secrets"
  ],
  "author": "Envpilot <hello@envpilot.dev> (https://www.envpilot.dev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafay99-epic/envpilot.dev"
  },
  "homepage": "https://www.envpilot.dev",
  "bugs": {
    "url": "https://github.com/rafay99-epic/envpilot.dev/issues"
  }
}
