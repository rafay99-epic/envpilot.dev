# Sandbox build values for the CLI and the VS Code extension.
#
# Copy to apps/cli/scripts/sandbox.env and fill in. That file is gitignored and
# is the ONLY place the sandbox build reads from. It deliberately does not fall
# back to the repo's .env.local, to your home directory, or to anything under
# your production working folder.
#
# Both values below are PUBLIC. WORKOS_CLIENT_ID is the same id the browser app
# exposes, and the Convex URL is a public deployment endpoint. No secret belongs
# in this file.
#
# Point these at a DEV deployment and a THROWAWAY WorkOS account. A sandbox
# build that talks to production is not a sandbox.

WORKOS_CLIENT_ID=client_replace_me
NEXT_PUBLIC_CONVEX_URL=https://replace-me.convex.cloud

# Where the sandboxed CLI keeps its own config and login. Never your real HOME.
ENVPILOT_SANDBOX_HOME=/tmp/envpilot-sandbox

# Vault/API routes for the sandboxed CLI. Local dev server, not production.
ENVPILOT_SANDBOX_API_URL=http://localhost:3000

# Server URL baked into the VS Code extension build. Same rule: not production.
ENVPILOT_SERVER_URL=http://localhost:3000
