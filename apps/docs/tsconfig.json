{
  "extends": "@envpilot/tsconfig/next.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // scripts/ runs under bun (Bun.YAML, import.meta.dir), not under the Next
  // build — typechecking it here would need @types/bun for one build tool.
  // `bun run reference:check` in CI is what proves it still works.
  "exclude": ["node_modules", "scripts"]
}
