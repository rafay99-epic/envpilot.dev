{
  "name": "envpilot",
  "displayName": "Envpilot",
  "description": "Securely sync environment variables from Envpilot to your local projects. Real-time revocation, clipboard protection, commit guard, and role-based access.",
  "version": "1.6.0",
  "publisher": "envpilot",
  "author": "Envpilot <hello@envpilot.dev> (https://www.envpilot.dev)",
  "license": "UNLICENSED",
  "homepage": "https://www.envpilot.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafay99-epic/envpilot.dev"
  },
  "bugs": {
    "url": "https://github.com/rafay99-epic/envpilot.dev/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionDependencies": [
    "vscode.git"
  ],
  "icon": "media/icon.png",
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "environment",
    "variables",
    "env",
    "secrets",
    "dotenv",
    "configuration",
    "sync",
    "vault",
    "security",
    "team"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "envpilot.signIn",
        "title": "Sign In",
        "category": "Envpilot",
        "icon": "$(sign-in)"
      },
      {
        "command": "envpilot.signOut",
        "title": "Sign Out",
        "category": "Envpilot",
        "icon": "$(sign-out)"
      },
      {
        "command": "envpilot.linkProject",
        "title": "Link Project",
        "category": "Envpilot",
        "icon": "$(link)"
      },
      {
        "command": "envpilot.unlinkProject",
        "title": "Unlink Project",
        "category": "Envpilot",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "envpilot.pullVariables",
        "title": "Pull Variables",
        "category": "Envpilot",
        "icon": "$(cloud-download)"
      },
      {
        "command": "envpilot.refresh",
        "title": "Refresh",
        "category": "Envpilot",
        "icon": "$(refresh)"
      },
      {
        "command": "envpilot.openDashboard",
        "title": "Open Dashboard",
        "category": "Envpilot",
        "icon": "$(link-external)"
      },
      {
        "command": "envpilot.showStatus",
        "title": "Show Status",
        "category": "Envpilot",
        "icon": "$(info)"
      },
      {
        "command": "envpilot.addDirectory",
        "title": "Add Directory",
        "category": "Envpilot",
        "icon": "$(new-folder)"
      },
      {
        "command": "envpilot.removeDirectory",
        "title": "Remove Directory",
        "category": "Envpilot",
        "icon": "$(trash)"
      },
      {
        "command": "envpilot.selectEnvironments",
        "title": "Select Environments",
        "category": "Envpilot",
        "icon": "$(server-environment)"
      },
      {
        "command": "envpilot.requestVariable",
        "title": "Request Variable",
        "category": "Envpilot",
        "icon": "$(add)"
      },
      {
        "command": "envpilot.installCommitGuard",
        "title": "Install Commit Guard Hook",
        "category": "Envpilot",
        "icon": "$(shield)"
      },
      {
        "command": "envpilot.removeCommitGuard",
        "title": "Remove Commit Guard Hook",
        "category": "Envpilot",
        "icon": "$(trash)"
      },
      {
        "command": "envpilot.openDashboardPanel",
        "title": "Open Dashboard Panel",
        "category": "Envpilot",
        "icon": "$(dashboard)"
      },
      {
        "command": "envpilot.switchAccount",
        "title": "Switch Account",
        "category": "Envpilot",
        "icon": "$(account)"
      },
      {
        "command": "envpilot.signOutAll",
        "title": "Sign Out of All Accounts",
        "category": "Envpilot",
        "icon": "$(close-all)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "envpilot",
          "title": "Envpilot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "envpilot": [
        {
          "id": "envpilot.projects",
          "name": "Projects"
        },
        {
          "id": "envpilot.variables",
          "name": "Variables"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "envpilot.projects",
        "contents": "$(shield) Welcome to Envpilot\n\nSecurely manage and sync environment variables across your team.\nNo more sharing .env files over Slack or email.\n\n[$(sign-in) Sign In to Get Started](command:envpilot.signIn)\n\n$(info) [Learn more on the dashboard](command:envpilot.openDashboard)",
        "when": "!envpilot.isAuthenticated"
      },
      {
        "view": "envpilot.variables",
        "contents": "$(lock) Environment Variables\n\nSign in to securely sync variables from your team's vault to your local .env files.\n\n[$(sign-in) Sign In](command:envpilot.signIn)",
        "when": "!envpilot.isAuthenticated"
      },
      {
        "view": "envpilot.variables",
        "contents": "$(symbol-variable) No Variables Yet\n\nLink a project to start syncing environment variables to this workspace.\n\n[$(link) Link Project](command:envpilot.linkProject)\n\n[$(link-external) Open Dashboard](command:envpilot.openDashboard)",
        "when": "envpilot.isAuthenticated && !envpilot.hasLinkedProject"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "envpilot.refresh",
          "when": "view == envpilot.projects && envpilot.isAuthenticated",
          "group": "navigation@1"
        },
        {
          "command": "envpilot.linkProject",
          "when": "view == envpilot.projects && envpilot.isAuthenticated",
          "group": "navigation@2"
        },
        {
          "command": "envpilot.openDashboardPanel",
          "when": "view == envpilot.projects && envpilot.isAuthenticated",
          "group": "navigation@3"
        },
        {
          "command": "envpilot.switchAccount",
          "when": "view == envpilot.projects && envpilot.isAuthenticated",
          "group": "navigation@4"
        },
        {
          "command": "envpilot.requestVariable",
          "when": "view == envpilot.projects && envpilot.isAuthenticated",
          "group": "navigation@5"
        },
        {
          "command": "envpilot.openDashboard",
          "when": "view == envpilot.projects && envpilot.isAuthenticated",
          "group": "overflow@1"
        },
        {
          "command": "envpilot.signOut",
          "when": "view == envpilot.projects && envpilot.isAuthenticated",
          "group": "overflow@3"
        },
        {
          "command": "envpilot.signOutAll",
          "when": "view == envpilot.projects && envpilot.isAuthenticated",
          "group": "overflow@4"
        },
        {
          "command": "envpilot.pullVariables",
          "when": "view == envpilot.variables && envpilot.isAuthenticated",
          "group": "navigation@1"
        },
        {
          "command": "envpilot.refresh",
          "when": "view == envpilot.variables && envpilot.isAuthenticated",
          "group": "navigation@2"
        },
        {
          "command": "envpilot.requestVariable",
          "when": "view == envpilot.variables && envpilot.isAuthenticated && envpilot.isDeveloper",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "envpilot.linkProject",
          "when": "view == envpilot.projects && viewItem == project",
          "group": "inline@1"
        },
        {
          "command": "envpilot.unlinkProject",
          "when": "view == envpilot.projects && viewItem == linkedProject",
          "group": "inline@3"
        },
        {
          "command": "envpilot.addDirectory",
          "when": "view == envpilot.projects && viewItem == linkedProject",
          "group": "inline@1"
        },
        {
          "command": "envpilot.pullVariables",
          "when": "view == envpilot.projects && viewItem == linkedDirectory",
          "group": "inline@1"
        },
        {
          "command": "envpilot.removeDirectory",
          "when": "view == envpilot.projects && viewItem == linkedDirectory",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "Envpilot",
      "properties": {
        "envpilot.serverUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "The URL of the Envpilot server (auto-configured at build time)"
        },
        "envpilot.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Automatically sync variables when workspace opens"
        },
        "envpilot.syncInterval": {
          "type": "number",
          "default": 300,
          "description": "Interval (in seconds) for checking permission changes",
          "minimum": 60,
          "maximum": 3600
        },
        "envpilot.targetFile": {
          "type": "string",
          "default": ".env.local",
          "description": "Default target file for synced variables"
        },
        "envpilot.environment": {
          "type": "string",
          "default": "development",
          "enum": [
            "development",
            "staging",
            "production"
          ],
          "description": "Default environment for synced variables"
        },
        "envpilot.preventCopyOnRevoke": {
          "type": "boolean",
          "default": true,
          "description": "Delete synced .env files when permissions are revoked"
        },
        "envpilot.defaultConflictResolution": {
          "type": "string",
          "default": "prompt",
          "enum": [
            "prompt",
            "overwrite",
            "backup",
            "merge",
            "skip"
          ],
          "enumDescriptions": [
            "Always ask what to do",
            "Replace existing file",
            "Create backup before replacing",
            "Merge with existing file",
            "Skip conflicting directories"
          ],
          "description": "Default action when existing .env files are found"
        },
        "envpilot.enableMultiDirectorySync": {
          "type": "boolean",
          "default": true,
          "description": "Allow linking multiple directories to the same project"
        },
        "envpilot.syncOnDirectoryOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically sync when opening a linked directory"
        },
        "envpilot.convexUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Convex deployment URL for real-time sync (auto-detected from server if empty)"
        },
        "envpilot.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLens annotations above .env files with sync status and actions"
        },
        "envpilot.commitGuard.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable dual-layer .env commit protection (VS Code staging guard + pre-commit hook)"
        },
        "envpilot.commitGuard.autoInstallHook": {
          "type": "boolean",
          "default": true,
          "description": "Automatically install a pre-commit hook to block .env file commits"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build": "node scripts/build.mjs",
    "compile": "npm run typecheck && npm run lint && npm run build && vsce package --no-dependencies",
    "dev": "npm-run-all -p dev:*",
    "dev:esbuild": "node scripts/build.mjs --watch",
    "dev:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run typecheck && npm run lint && node scripts/build.mjs --minify",
    "package:vsix": "npm run package && vsce package --no-dependencies",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@envpilot/eslint-config": "workspace:*",
    "@envpilot/tsconfig": "workspace:*",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.19.8",
    "eslint": "^9",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@sentry/node": "^10.43.0",
    "axios": "^1.6.2",
    "convex": "^1.32.0"
  }
}
