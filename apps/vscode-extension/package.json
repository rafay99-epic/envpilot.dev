{
  "name": "envpilot",
  "displayName": "Envpilot",
  "description": "Securely sync environment variables from Envpilot to your local projects",
  "version": "0.1.0",
  "publisher": "envpilot",
  "repository": {
    "type": "git",
    "url": "https://github.com/envpilot/envpilot"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "environment",
    "variables",
    "env",
    "secrets",
    "dotenv",
    "configuration"
  ],
  "activationEvents": [
    "workspaceContains:.env*",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "envpilot.signIn",
        "title": "Sign In",
        "category": "Envpilot",
        "icon": "$(sign-in)"
      },
      {
        "command": "envpilot.signOut",
        "title": "Sign Out",
        "category": "Envpilot",
        "icon": "$(sign-out)"
      },
      {
        "command": "envpilot.linkProject",
        "title": "Link Project",
        "category": "Envpilot",
        "icon": "$(link)"
      },
      {
        "command": "envpilot.unlinkProject",
        "title": "Unlink Project",
        "category": "Envpilot",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "envpilot.pullVariables",
        "title": "Pull Variables",
        "category": "Envpilot",
        "icon": "$(cloud-download)"
      },
      {
        "command": "envpilot.refresh",
        "title": "Refresh",
        "category": "Envpilot",
        "icon": "$(refresh)"
      },
      {
        "command": "envpilot.openDashboard",
        "title": "Open Dashboard",
        "category": "Envpilot",
        "icon": "$(link-external)"
      },
      {
        "command": "envpilot.showStatus",
        "title": "Show Status",
        "category": "Envpilot",
        "icon": "$(info)"
      },
      {
        "command": "envpilot.addDirectory",
        "title": "Add Directory",
        "category": "Envpilot",
        "icon": "$(new-folder)"
      },
      {
        "command": "envpilot.removeDirectory",
        "title": "Remove Directory",
        "category": "Envpilot",
        "icon": "$(trash)"
      },
      {
        "command": "envpilot.selectEnvironments",
        "title": "Select Environments",
        "category": "Envpilot",
        "icon": "$(server-environment)"
      },
      {
        "command": "envpilot.requestVariable",
        "title": "Request Variable",
        "category": "Envpilot",
        "icon": "$(git-pull-request-create)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "envpilot",
          "title": "Envpilot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "envpilot": [
        {
          "id": "envpilot.projects",
          "name": "Projects"
        },
        {
          "id": "envpilot.variables",
          "name": "Variables"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "envpilot.projects",
        "contents": "Welcome to Envpilot\n\nSecurely sync environment variables to your local projects. No more sharing .env files over Slack.\n\n[$(sign-in) Sign In to Get Started](command:envpilot.signIn)\n\n[$(link-external) Open Dashboard](command:envpilot.openDashboard)",
        "when": "!envpilot.isAuthenticated"
      },
      {
        "view": "envpilot.variables",
        "contents": "Sign in to view and sync your environment variables.\n\n[$(sign-in) Sign In](command:envpilot.signIn)",
        "when": "!envpilot.isAuthenticated"
      },
      {
        "view": "envpilot.variables",
        "contents": "Link a project to view its environment variables.\n\n[$(link) Link Project](command:envpilot.linkProject)",
        "when": "envpilot.isAuthenticated && !envpilot.hasLinkedProject"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "envpilot.refresh",
          "when": "view == envpilot.projects && envpilot.isAuthenticated",
          "group": "navigation@1"
        },
        {
          "command": "envpilot.linkProject",
          "when": "view == envpilot.projects && envpilot.isAuthenticated",
          "group": "navigation@2"
        },
        {
          "command": "envpilot.openDashboard",
          "when": "view == envpilot.projects && envpilot.isAuthenticated",
          "group": "overflow@1"
        },
        {
          "command": "envpilot.signOut",
          "when": "view == envpilot.projects && envpilot.isAuthenticated",
          "group": "overflow@2"
        },
        {
          "command": "envpilot.pullVariables",
          "when": "view == envpilot.variables && envpilot.isAuthenticated",
          "group": "navigation@1"
        },
        {
          "command": "envpilot.refresh",
          "when": "view == envpilot.variables && envpilot.isAuthenticated",
          "group": "navigation@2"
        },
        {
          "command": "envpilot.requestVariable",
          "when": "view == envpilot.variables && envpilot.isAuthenticated && envpilot.userRole == member",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "envpilot.linkProject",
          "when": "view == envpilot.projects && viewItem == project",
          "group": "inline@1"
        },
        {
          "command": "envpilot.unlinkProject",
          "when": "view == envpilot.projects && viewItem == linkedProject",
          "group": "inline@3"
        },
        {
          "command": "envpilot.addDirectory",
          "when": "view == envpilot.projects && viewItem == linkedProject",
          "group": "inline@1"
        },
        {
          "command": "envpilot.removeDirectory",
          "when": "view == envpilot.projects && viewItem == linkedDirectory",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "Envpilot",
      "properties": {
        "envpilot.serverUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "The URL of the Envpilot server"
        },
        "envpilot.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Automatically sync variables when workspace opens"
        },
        "envpilot.syncInterval": {
          "type": "number",
          "default": 300,
          "description": "Interval (in seconds) for checking permission changes",
          "minimum": 60,
          "maximum": 3600
        },
        "envpilot.targetFile": {
          "type": "string",
          "default": ".env.local",
          "description": "Default target file for synced variables"
        },
        "envpilot.environment": {
          "type": "string",
          "default": "development",
          "enum": [
            "development",
            "staging",
            "production"
          ],
          "description": "Default environment for synced variables"
        },
        "envpilot.preventCopyOnRevoke": {
          "type": "boolean",
          "default": true,
          "description": "Delete synced .env files when permissions are revoked"
        },
        "envpilot.defaultConflictResolution": {
          "type": "string",
          "default": "prompt",
          "enum": [
            "prompt",
            "overwrite",
            "backup",
            "merge",
            "skip"
          ],
          "enumDescriptions": [
            "Always ask what to do",
            "Replace existing file",
            "Create backup before replacing",
            "Merge with existing file",
            "Skip conflicting directories"
          ],
          "description": "Default action when existing .env files are found"
        },
        "envpilot.enableMultiDirectorySync": {
          "type": "boolean",
          "default": true,
          "description": "Allow linking multiple directories to the same project"
        },
        "envpilot.syncOnDirectoryOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically sync when opening a linked directory"
        },
        "envpilot.enableRealTimeSync": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time permission revocation detection (recommended)"
        },
        "envpilot.realTimeSyncInterval": {
          "type": "number",
          "default": 5,
          "description": "Interval (in seconds) for real-time permission check",
          "minimum": 2,
          "maximum": 30
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "compile": "npm run typecheck && npm run lint && npm run build",
    "dev": "npm-run-all -p dev:*",
    "dev:esbuild": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "dev:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run typecheck && npm run lint && esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@envpilot/eslint-config": "workspace:*",
    "@envpilot/tsconfig": "workspace:*",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.19.8",
    "eslint": "^9",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "uuid": "^9.0.1"
  }
}
