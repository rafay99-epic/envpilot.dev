{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "overrides": [
      {
        // True black is the brand, not an oversight. See CLAUDE.md.
        "files": ["apps/**/src/**"],
        "rules": ["react-doctor/no-pure-black-background"]
      },
      {
        // Cleanup IS returned: the effect removes every listener and calls
        // observer.disconnect(). The detector cannot pair add and remove
        // across the `for (const el of [pane, preview])` loop.
        "files": ["**/hooks/useSplitScrollSync.ts"],
        "rules": ["react-doctor/effect-needs-cleanup"]
      }
    ]
  }
}
